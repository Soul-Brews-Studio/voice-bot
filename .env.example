# Discord Bot
DISCORD_TOKEN=your_discord_bot_token
DISCORD_APP_ID=your_app_id
DISCORD_GUILD_ID=your_guild_id
DC_OWNER_IDS=your_discord_user_id

# STT — Groq Whisper (free tier)
STT_BACKEND=groq
GROQ_API_KEY=your_groq_api_key
GROQ_STT_MODEL=whisper-large-v3
GROQ_STT_LANGUAGE=th

# TTS
# Options: mac-say (free, macOS only), edge (free, cloud)
# TTS_BACKEND is auto-detected from voice profile
TTS_VOICE=th-TH-PremwadeeNeural

# Brain — Groq LLM (free tier)
BRAIN_MODE=gemini
BRAIN_MODEL=llama-3.3-70b-versatile
USE_BRAIN=true
CANNED_REPLY=Yes, I'm listening

# Audio pipeline
SILENCE_THRESHOLD_MS=1500
MAX_CHUNK_MS=30000

# Reply queue
MAX_REPLY_QUEUE=5
STALE_REPLY_MS=60000

# Session
AUTO_FLUSH_MS=900000
AUTO_LEAVE_ALONE_MS=300000
AUTO_LEAVE_SILENCE_MS=900000
TRANSCRIPT_DIR=transcripts

# UI (optional)
# UI_PORT=8080
# UI_PASSWORD=changeme
# UI_ENABLED=true
