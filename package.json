{
  "name": "voice-bot",
  "version": "0.1.0",
  "type": "module",
  "description": "Discord voice channel transcriber + AI secretary — real-time STT, AI replies, transcript export.",
  "scripts": {
    "start": "bun src/bot/index.ts",
    "dev": "bun --watch src/bot/index.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "bash scripts/fix-opus-abi.sh || true",
    "fix-opus": "bash scripts/fix-opus-abi.sh"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.16.0",
    "ffmpeg-static": "^5.2.0",
    "opusscript": "^0.1.1",
    "prism-media": "^1.3.5",
    "sodium-native": "^5.1.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
